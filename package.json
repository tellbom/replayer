{
  "name": "dsh-recorder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "packages/*",
    "apps/*/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --ext .ts,.mts,.js,.mjs",
    "e2e": "playwright test",
    "dsh": "node packages/cli/dist/index.js",
    "check:constraints": "node scripts/check-constraints.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
